.shop-head { padding: 12px 16px 4px; }
.shop-table { font-size: 17px; font-weight: bold; display: block; }

.cats { white-space: nowrap; padding: 10px 16px 6px; background: #f3f4f6; }
.cat {
  display: inline-block; border: 1px solid #d1d5db; background: #fff; color: #6b7280;
  padding: 6px 16px; border-radius: 16px; font-size: 14px; margin-right: 8px;
}
.cat.active { background: #4f46e5; border-color: #4f46e5; color: #fff; font-weight: bold; }

.products { padding: 8px 16px; }
.pcard {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; border-radius: 12px; padding: 13px 14px; margin-bottom: 10px;
}
.pname { font-size: 15px; font-weight: bold; }
.pprice { color: #ef4444; font-size: 15px; margin-top: 3px; }
.pstock { color: #9ca3af; font-size: 11px; margin-left: 6px; }
.add {
  width: 34px; height: 34px; border-radius: 50%; background: #4f46e5; color: #fff;
  font-size: 20px; text-align: center; line-height: 34px;
}
.stepper { display: flex; align-items: center; gap: 10px; }
.step-btn {
  width: 30px; height: 30px; border-radius: 50%; border: 1px solid #4f46e5;
  background: #fff; color: #4f46e5; font-size: 17px; text-align: center; line-height: 28px;
}
.step-num { min-width: 22px; text-align: center; font-weight: bold; }
.soldout { color: #9ca3af; font-size: 13px; }
.empty { text-align: center; color: #9ca3af; padding: 40px 0; }

.cartbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
  background: #111827; color: #fff;
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 16px;
}
.cart-info { font-size: 14px; }
.cart-total { color: #fbbf24; font-size: 17px; font-weight: bold; margin-left: 4px; }
.cart-count {
  display: inline-block; background: #ef4444; border-radius: 10px;
  padding: 1px 8px; font-size: 12px; margin-right: 8px;
}
.submit-btn { width: auto; padding: 10px 22px; font-size: 15px; margin: 0; }

/* 确认弹层 */
.citem {
  display: flex; justify-content: space-between; padding: 6px 0;
  border-bottom: 1px dashed #f3f4f6; color: #374151;
}
.citem .price, .ctotal .price { color: #ef4444; font-weight: bold; }
.ctotal { text-align: right; margin: 8px 0 10px; }
.ctotal .price { font-size: 18px; }
.remark {
  width: 100%; border: 1px solid #d1d5db; border-radius: 8px;
  padding: 8px; font-size: 14px; margin-bottom: 12px; background: #fff;
}
